<div id="<%= dom_id room %>">
  <h2>
    <%= room.name %>
  </h2>
    <%= render "messages/form", room: room %>
    <h2>Messages</h2>
      <div id="messages">
        <% room.messages.reverse.each do |message| %>
          <%= render "messages/message", message: message, admin: current_user.admin?, user: current_user %>
        <% end %>
      </div>
</div>
